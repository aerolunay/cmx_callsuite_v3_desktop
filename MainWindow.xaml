<Window x:Class="CmxDialer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CMX CallSuite Desktop v3"
        Icon="pack://application:,,,/Assets/handset.ico"
        Width="400" Height="720"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Topmost="{Binding Topmost}"
        Background="{StaticResource BgBrush}"
        BorderBrush="{StaticResource NavyBrush}"
        BorderThickness="1"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource NavyBrush}">
    <DockPanel>
        <!-- Custom title bar: drag to move. No minimize / maximize, by design. -->
        <Border DockPanel.Dock="Top" Height="36" Background="{StaticResource NavyBrush}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="12,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- CallMax mark on a white tile: its navy half would vanish on the navy bar -->
                    <Border Width="22" Height="22" CornerRadius="5" Background="White">
                        <Image Source="pack://application:,,,/Assets/callmax-mark.png" Width="16" Height="16"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="CMX CallSuite Desktop v3" Foreground="White" FontSize="13" FontWeight="SemiBold"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Agent name + phone status now live in the dialer header, above the aux selection -->

                <Button Grid.Column="2" Style="{StaticResource TitleButton}" Command="{Binding ToggleTopmostCommand}"
                        Tag="{Binding Topmost}" ToolTip="Keep on top of other windows">
                    <Path Data="{StaticResource IconPin}" Style="{StaticResource Icon}" Width="15" Height="15"/>
                </Button>

                <Button Grid.Column="3" Style="{StaticResource TitleButton}" Command="{Binding SignOutCommand}"
                        ToolTip="Sign out" Visibility="{Binding HasAgent, Converter={StaticResource BoolVis}}">
                    <Path Data="{StaticResource IconSignOut}" Style="{StaticResource Icon}" Width="15" Height="15"/>
                </Button>

                <Button Grid.Column="4" Style="{StaticResource TitleButton}" Command="{Binding CloseCommand}"
                        ToolTip="Close" Visibility="{Binding ShowClose, Converter={StaticResource BoolVis}}">
                    <Path Data="{StaticResource IconClose}" Style="{StaticResource Icon}" Width="12" Height="12"/>
                </Button>
            </Grid>
        </Border>

        <ContentControl Content="{Binding CurrentView}" Focusable="False"/>
    </DockPanel>
</Window>

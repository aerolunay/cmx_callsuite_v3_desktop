<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:infra="clr-namespace:CmxDialer.Infrastructure">

    <!-- Brand colors (frontend/src/styles/theme.css) -->
    <SolidColorBrush x:Key="NavyBrush" Color="#182D57"/>
    <SolidColorBrush x:Key="CyanBrush" Color="#00ADEE"/>
    <SolidColorBrush x:Key="CyanSoftBrush" Color="#E0F5FD"/>
    <SolidColorBrush x:Key="CyanTextBrush" Color="#0079A8"/>
    <SolidColorBrush x:Key="BgBrush" Color="#F4F6FA"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LineBrush" Color="#D9DEE6"/>
    <SolidColorBrush x:Key="LineSoftBrush" Color="#E3E7EE"/>
    <SolidColorBrush x:Key="DisabledBrush" Color="#EEF1F6"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#8A97AD"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#5A6A85"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#C0392B"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#A12F23"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FCEBEA"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#1E7E34"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E8F4EC"/>
    <SolidColorBrush x:Key="WarnTextBrush" Color="#8A3F0B"/>
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#FFF4EC"/>
    <SolidColorBrush x:Key="WarnLineBrush" Color="#F0C9A8"/>
    <SolidColorBrush x:Key="TitleMutedBrush" Color="#C9D3E6"/>

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>

    <BooleanToVisibilityConverter x:Key="BoolVis"/>
    <infra:InverseBoolToVisibilityConverter x:Key="InverseBoolVis"/>
    <infra:StringToVisibilityConverter x:Key="StringVis"/>
    <infra:LoadingVisibilityConverter x:Key="LoadingVis"/>

    <!-- Icons (24x24 stroke geometries) -->
    <Geometry x:Key="IconPhone">M5,4 L9,4 L11,9 L8.5,10.5 A11,11 0 0 0 13.5,15.5 L15,13 L20,15 L20,19 A2,2 0 0 1 18,21 A16,16 0 0 1 3,6 A2,2 0 0 1 5,4 Z</Geometry>
    <Geometry x:Key="IconPhonePlus">M5,4 L9,4 L11,9 L8.5,10.5 A11,11 0 0 0 13.5,15.5 L15,13 L20,15 L20,19 A2,2 0 0 1 18,21 A16,16 0 0 1 3,6 A2,2 0 0 1 5,4 Z M17,2 L17,8 M14,5 L20,5</Geometry>
    <Geometry x:Key="IconHangUp">M3,15 C8,10 16,10 21,15 L18.5,17.5 L15,16 L15,13 A11,11 0 0 0 9,13 L9,16 L5.5,17.5 Z</Geometry>
    <Geometry x:Key="IconMic">M12,3 A3,3 0 0 0 9,6 L9,12 A3,3 0 0 0 15,12 L15,6 A3,3 0 0 0 12,3 Z M19,11 A7,7 0 0 1 5,11 M12,18 L12,21</Geometry>
    <Geometry x:Key="IconMicOff">M12,3 A3,3 0 0 0 9,6 L9,12 A3,3 0 0 0 15,12 L15,6 A3,3 0 0 0 12,3 Z M19,11 A7,7 0 0 1 5,11 M12,18 L12,21 M4,4 L20,20</Geometry>
    <Geometry x:Key="IconPause">M9,5 L9,19 M15,5 L15,19</Geometry>
    <Geometry x:Key="IconKeypad">M5,4 L7,4 L7,6 L5,6 Z M11,4 L13,4 L13,6 L11,6 Z M17,4 L19,4 L19,6 L17,6 Z M5,10 L7,10 L7,12 L5,12 Z M11,10 L13,10 L13,12 L11,12 Z M17,10 L19,10 L19,12 L17,12 Z M5,16 L7,16 L7,18 L5,18 Z M11,16 L13,16 L13,18 L11,18 Z M17,16 L19,16 L19,18 L17,18 Z M11,21 L13,21 L13,23 L11,23 Z</Geometry>
    <Geometry x:Key="IconSignOut">M15,4 L19,4 L19,20 L15,20 M10,17 L15,12 L10,7 M15,12 L3,12</Geometry>
    <Geometry x:Key="IconPin">M9,3 L15,3 M10,3 L10,9 L6,13 L18,13 L14,9 L14,3 M12,13 L12,21</Geometry>
    <Geometry x:Key="IconClose">M6,6 L18,18 M18,6 L6,18</Geometry>
    <Geometry x:Key="IconCheck">M5,12 L10,17 L19,7</Geometry>
    <Geometry x:Key="IconRefresh">M20,12 A8,8 0 1 1 17.7,6.3 M20,4 L20,9 L15,9</Geometry>
    <Geometry x:Key="IconPlay">M8,5 L19,12 L8,19 Z</Geometry>
    <Geometry x:Key="IconStop">M7,7 L17,7 L17,17 L7,17 Z</Geometry>

    <Style x:Key="Icon" TargetType="Path">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
    </Style>
    <Style x:Key="FilledIcon" TargetType="Path" BasedOn="{StaticResource Icon}">
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
    </Style>

    <!-- Text. No implicit TextBlock style on purpose: app-level implicit TextBlock styles leak into
         button templates and override their text color. Font + navy text are inherited from MainWindow. -->
    <Style x:Key="Caps" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <!-- Buttons -->
    <Style x:Key="ButtonBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.78"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource CyanBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#D9DEE6"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#D9DEE6"/>
                            <Setter Property="Foreground" Value="#6B7890"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource NavyBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NavyBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource NavyBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
    </Style>
    <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="DangerOutlineButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E3B4AE"/>
        <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}"/>
    </Style>
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource CyanTextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter x:Name="Cp" VerticalAlignment="Center"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Title bar icon button -->
    <Style x:Key="TitleButton" TargetType="Button">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Foreground" Value="{StaticResource TitleMutedBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#5E6F93"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- In-call control (Mute / Hold / Keypad / Line 2). Tag=True shows the active state. -->
    <Style x:Key="ControlButton" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
        <Setter Property="Height" Value="58"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="3,0"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Background" Value="{StaticResource NavyBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource NavyBrush}"/>
                <Setter Property="Foreground" Value="White"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Segmented / tab button. Tag=True = selected. -->
    <Style x:Key="SegmentButton" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
        <Setter Property="Height" Value="34"/>
        <Setter Property="FontSize" Value="13"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Background" Value="{StaticResource NavyBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource NavyBrush}"/>
                <Setter Property="Foreground" Value="White"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TabButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource CyanBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Disposition tile -->
    <Style x:Key="DispositionTile" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Margin" Value="3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="10,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Label" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Path x:Name="Tick" Grid.Column="1" Data="{StaticResource IconCheck}" Width="13" Height="13" Stretch="Uniform"
                                  Stroke="{StaticResource CyanTextBrush}" StrokeThickness="3" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" Margin="6,0,0,0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource CyanBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CyanSoftBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource CyanBrush}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DisabledBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LineSoftBrush}"/>
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text input with placeholder (placeholder text goes in Tag) -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <!-- Placeholder sits exactly where typed text starts: same padding as the text,
                                 plus the 2px WPF adds before the caret; follows the box's TextAlignment. -->
                            <TextBlock x:Name="Placeholder" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{StaticResource DisabledTextBrush}"
                                       FontSize="{TemplateBinding FontSize}" Margin="{TemplateBinding Padding}" Padding="2,0,2,0" IsHitTestVisible="False"
                                       TextAlignment="{Binding TextAlignment, RelativeSource={RelativeSource TemplatedParent}}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Visibility="Collapsed"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="Text" Value="{x:Null}">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <!-- Must stay below the Text triggers: once the box is clicked the placeholder goes -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource CyanBrush}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DisabledBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LineSoftBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- Line badge (L1 / L2) -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>

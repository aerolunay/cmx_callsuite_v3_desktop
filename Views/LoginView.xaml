<UserControl x:Class="CmxDialer.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,40,24,20">
        <StackPanel VerticalAlignment="Top">
            <Image Source="pack://application:,,,/Assets/voxsuite-logo.png" Height="84" HorizontalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- Sign-in card -->
            <Border Style="{StaticResource Card}" Padding="20,22" Margin="0,32,0,0">
            <StackPanel>
            <TextBlock Text="Sign in" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Use the same email you use for VoxSuite." Style="{StaticResource Muted}"
                       FontSize="13" Margin="0,4,0,20"/>

            <!-- Step 1: email -->
            <StackPanel Visibility="{Binding IsEmailStep, Converter={StaticResource BoolVis}}">
                <TextBlock Text="EMAIL" Style="{StaticResource Caps}" Margin="0,0,0,6"/>
                <TextBox x:Name="EmailBox" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Tag="you@domain.com" TextAlignment="Center"/>
                <Button Content="Continue" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0"
                        Command="{Binding ContinueCommand}" IsDefault="{Binding IsEmailStep}"/>
            </StackPanel>

            <!-- Step 2: choose method (only when an authenticator is set up) -->
            <StackPanel Visibility="{Binding IsChooseStep, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding Email}" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Text="How would you like to get your login code?" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,14"/>
                <Button Content="Use my authenticator app" Style="{StaticResource PrimaryButton}"
                        Command="{Binding UseAuthenticatorCommand}"/>
                <Button Content="Email me a code" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0"
                        Command="{Binding UseEmailCodeCommand}"/>
                <Button Content="Use a different email" Style="{StaticResource LinkButton}" Margin="0,16,0,0"
                        HorizontalAlignment="Left" Command="{Binding BackCommand}"/>
            </StackPanel>

            <!-- Step 3: enter code -->
            <StackPanel Visibility="{Binding IsCodeStep, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding CodePrompt}" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,12"/>
                <TextBlock Text="LOGIN CODE" Style="{StaticResource Caps}" Margin="0,0,0,6"/>
                <TextBox x:Name="CodeBox" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Tag="6-digit code"
                         FontSize="20" FontWeight="SemiBold" MaxLength="8" TextAlignment="Center"/>
                <Button Content="Sign in" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0"
                        Command="{Binding VerifyCommand}" IsDefault="{Binding IsCodeStep}"/>
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="Back" Style="{StaticResource LinkButton}" Command="{Binding BackCommand}"/>
                    <Button Content="Resend code" Style="{StaticResource LinkButton}" Margin="18,0,0,0"
                            Command="{Binding ResendCommand}"
                            Visibility="{Binding IsEmailCode, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
            </StackPanel>

            <Border Background="{StaticResource SuccessSoftBrush}" CornerRadius="10" Padding="12,10" Margin="0,16,0,0"
                    Visibility="{Binding Info, Converter={StaticResource StringVis}}">
                <TextBlock Text="{Binding Info}" Foreground="{StaticResource SuccessBrush}" FontSize="12" TextWrapping="Wrap"/>
            </Border>
            <Border Background="{StaticResource DangerSoftBrush}" CornerRadius="10" Padding="12,10" Margin="0,16,0,0"
                    Visibility="{Binding Error, Converter={StaticResource StringVis}}">
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerTextBrush}" FontSize="12" TextWrapping="Wrap"/>
            </Border>
            </StackPanel>
            </Border>
        </StackPanel>

        <TextBlock Text="{Binding AppVersion, StringFormat='VoxSuite v{0} · SIP Phone Solutions'}" Style="{StaticResource Muted}" FontSize="11"
                   VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
    </Grid>
</UserControl>

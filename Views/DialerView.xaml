<UserControl x:Class="CmxDialer.Views.DialerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CmxDialer.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- status -->
            <RowDefinition Height="Auto"/>  <!-- tabs -->
            <RowDefinition Height="Auto"/>  <!-- phone -->
            <RowDefinition Height="Auto"/>  <!-- message -->
            <RowDefinition Height="*"/>     <!-- disposition -->
        </Grid.RowDefinitions>

        <!-- ============================================================ AGENT + STATUS -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,10">
            <StackPanel>
                <!-- Agent name, live status and time in status -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding AgentName}" FontSize="15" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding AgentName}"/>
                    <!-- Doubles as the phone-registration indicator -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"
                                ToolTip="{Binding HeaderStatusTooltip}">
                        <Ellipse Width="9" Height="9" Fill="{Binding HeaderStatusColor}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding HeaderStatusText}" Foreground="{Binding HeaderStatusColor}" FontSize="12"
                                   FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusTimer}" Style="{StaticResource Muted}" FontWeight="SemiBold"
                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding PhoneRegistered, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                </Grid>

                <!-- Aux selection -->
                <Grid>
                    <ComboBox ItemsSource="{Binding ManualStatuses}" SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                              DisplayMemberPath="Label" FontWeight="SemiBold" IsEnabled="{Binding CanChangeStatus}"
                              Visibility="{Binding IsSystemStatus, Converter={StaticResource InverseBoolVis}}"/>

                    <!-- System statuses (In Call, On Hold, After Call Work) can't be picked by hand -->
                    <Border Height="34" CornerRadius="6" Background="{StaticResource DisabledBrush}"
                            BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="1" Padding="10,0"
                            Visibility="{Binding IsSystemStatus, Converter={StaticResource BoolVis}}"
                            ToolTip="Set automatically by the dialer">
                        <TextBlock Text="{Binding StatusLabel}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ============================================================ TABS -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Height="36" Padding="4,0,12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource TabButton}" Content="Phone" Command="{Binding ShowPhoneTabCommand}" Tag="{Binding ShowPhoneTab}"/>
                <Button Grid.Column="1" Style="{StaticResource TabButton}" Command="{Binding ShowCallbacksTabCommand}" Tag="{Binding ShowCallbacks}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Callbacks" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <Border Background="{StaticResource CyanBrush}" CornerRadius="8" Padding="6,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding Callbacks.HasItems, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding Callbacks.Count}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="2" Text="{Binding CampaignSummary}" Style="{StaticResource Muted}" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,8,0"
                           ToolTip="{Binding CampaignSummary}"/>
                <Button Grid.Column="3" Content="Change" Style="{StaticResource LinkButton}" Command="{Binding ChangeCampaignCommand}"
                        ToolTip="Switch campaign (only while Not Ready)"/>
            </Grid>
        </Border>

        <!-- ============================================================ PHONE -->
        <Border Grid.Row="2" Padding="12" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                Visibility="{Binding ShowPhoneTab, Converter={StaticResource BoolVis}}">
            <Grid>
                <!-- Idle -->
                <StackPanel Visibility="{Binding ShowIdle, Converter={StaticResource BoolVis}}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="WORKING" Style="{StaticResource Caps}"/>
                            <TextBlock Text="{Binding CampaignSummary}" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding IdleMessage}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource PrimaryButton}" Height="48" Margin="0,10,0,0" Command="{Binding DialNextCommand}"
                            Visibility="{Binding ShowDialNext, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPhone}" Style="{StaticResource Icon}"/>
                            <TextBlock Text="Dial Next Lead" Margin="8,0,0,0" FontSize="15" FontWeight="Bold"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>

                    <Border Background="{StaticResource CyanSoftBrush}" CornerRadius="10" Padding="12,10" Margin="0,10,0,0"
                            Visibility="{Binding ShowAutoDialInfo, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="Auto-dial campaign — set yourself Ready and calls start on their own."
                                   Foreground="{StaticResource CyanTextBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding ManualNumber, UpdateSourceTrigger=PropertyChanged}" Tag="Manual dial — phone number"/>
                        <Button Grid.Column="1" Content="Dial" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Width="72"
                                Command="{Binding ManualDialCommand}"/>
                    </Grid>
                </StackPanel>

                <!-- Connecting (auto-answer) -->
                <StackPanel Visibility="{Binding ShowConnecting, Converter={StaticResource BoolVis}}">
                    <Border Background="White" BorderBrush="{StaticResource CyanBrush}" BorderThickness="2" CornerRadius="10" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="46" Height="46" CornerRadius="23" Background="{StaticResource CyanSoftBrush}">
                                <Path Data="{StaticResource IconPhone}" Width="22" Height="22" Stretch="Uniform"
                                      Stroke="{StaticResource CyanTextBrush}" StrokeThickness="2" StrokeLineJoin="Round"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DirectionText, StringFormat={}{0} call}" Style="{StaticResource Caps}"
                                           Foreground="{StaticResource CyanTextBrush}"/>
                                <TextBlock Text="{Binding ContactName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding ContactNumber}" Style="{StaticResource Muted}" FontSize="13"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Background="{StaticResource SuccessSoftBrush}" CornerRadius="10" Padding="12,12" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Auto-answering · connecting audio…" Foreground="{StaticResource SuccessBrush}"
                                       FontWeight="SemiBold" FontSize="13" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Your headset connects automatically — no need to click answer." Style="{StaticResource Muted}"
                               TextAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>

                <!-- In call -->
                <StackPanel Visibility="{Binding ShowInCall, Converter={StaticResource BoolVis}}">
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{Binding CallStateColor}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CallStateText}" Foreground="{Binding CallStateColor}" FontSize="12"
                                           FontWeight="Bold" Margin="6,0,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding CallTimer}" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Grid.Row="1" Text="{Binding ContactName}" FontSize="16" FontWeight="SemiBold" Margin="0,4,8,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ContactNumber}" Style="{StaticResource Muted}"
                                       FontSize="13" Margin="0,6,0,0" TextWrapping="NoWrap"/>
                        </Grid>
                    </Border>

                    <UniformGrid Columns="4" Margin="-3,10,-3,0">
                        <Button Style="{StaticResource ControlButton}" Command="{Binding ToggleMuteCommand}" Tag="{Binding IsMuted}">
                            <StackPanel>
                                <Path Data="{StaticResource IconMicOff}" Style="{StaticResource Icon}"
                                      Visibility="{Binding IsMuted, Converter={StaticResource BoolVis}}"/>
                                <Path Data="{StaticResource IconMic}" Style="{StaticResource Icon}"
                                      Visibility="{Binding IsMuted, Converter={StaticResource InverseBoolVis}}"/>
                                <TextBlock Text="Mute" HorizontalAlignment="Center" Margin="0,3,0,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ControlButton}" Command="{Binding ToggleHoldCommand}" Tag="{Binding IsOnHold}">
                            <StackPanel>
                                <Path Data="{StaticResource IconPause}" Style="{StaticResource Icon}"/>
                                <TextBlock Text="Hold" HorizontalAlignment="Center" Margin="0,3,0,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ControlButton}" Command="{Binding ToggleKeypadCommand}">
                            <StackPanel>
                                <Path Data="{StaticResource IconKeypad}" Style="{StaticResource FilledIcon}"/>
                                <TextBlock Text="Keypad" HorizontalAlignment="Center" Margin="0,3,0,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ControlButton}" Command="{Binding OpenLineTwoCommand}">
                            <StackPanel>
                                <Path Data="{StaticResource IconPhonePlus}" Style="{StaticResource Icon}"/>
                                <TextBlock Text="Line 2" HorizontalAlignment="Center" Margin="0,3,0,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <Button Style="{StaticResource DangerButton}" Margin="0,10,0,0" Command="{Binding HangUpCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconHangUp}" Style="{StaticResource FilledIcon}" Width="20" Height="20"/>
                            <TextBlock Text="Hang Up" Margin="8,0,0,0" FontSize="15" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Keypad (DTMF) -->
                <StackPanel Visibility="{Binding ShowKeypad, Converter={StaticResource BoolVis}}">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DtmfSent}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{Binding CallTimer}" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
                    </Grid>
                    <UniformGrid Columns="3" Rows="4" Margin="-3,0">
                        <Button Content="1" Style="{StaticResource OutlineButton}" Height="36" Margin="3" FontSize="16" Command="{Binding DtmfCommand}" CommandParameter="1"/>
                        <Button Content="2" Style="{StaticResource OutlineButton}" Height="36" Margin="3" FontSize="16" Command="{Binding DtmfCommand}" CommandParameter="2"/>
                        <Button Content="3" Style="{StaticResource OutlineButton}" Height="36" Margin="3" FontSize="16" Command="{Binding DtmfCommand}" CommandParameter="3"/>
                        <Button Content="4" Style="{StaticResource OutlineButton}" Height="36" Margin="3" FontSize="16" Command="{Binding DtmfCommand}" CommandParameter="4"/>
                        <Button Content="5" Style="{StaticResource OutlineButton}" Height="36" Margin="3" FontSize="16" Command="{Binding DtmfCommand}" CommandParameter="5"/>
                        <Button Content="6" Style="{StaticResource OutlineButton}" Height="36" Margin="3" FontSize="16" Command="{Binding DtmfCommand}" CommandParameter="6"/>
                        <Button Content="7" Style="{StaticResource OutlineButton}" Height="36" Margin="3" FontSize="16" Command="{Binding DtmfCommand}" CommandParameter="7"/>
                        <Button Content="8" Style="{StaticResource OutlineButton}" Height="36" Margin="3" FontSize="16" Command="{Binding DtmfCommand}" CommandParameter="8"/>
                        <Button Content="9" Style="{StaticResource OutlineButton}" Height="36" Margin="3" FontSize="16" Command="{Binding DtmfCommand}" CommandParameter="9"/>
                        <Button Content="*" Style="{StaticResource OutlineButton}" Height="36" Margin="3" FontSize="16" Command="{Binding DtmfCommand}" CommandParameter="*"/>
                        <Button Content="0" Style="{StaticResource OutlineButton}" Height="36" Margin="3" FontSize="16" Command="{Binding DtmfCommand}" CommandParameter="0"/>
                        <Button Content="#" Style="{StaticResource OutlineButton}" Height="36" Margin="3" FontSize="16" Command="{Binding DtmfCommand}" CommandParameter="#"/>
                    </UniformGrid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Hide keypad" Style="{StaticResource OutlineButton}" Height="38" Margin="0,0,4,0"
                                Command="{Binding ToggleKeypadCommand}"/>
                        <Button Grid.Column="1" Content="Hang Up" Style="{StaticResource DangerButton}" Height="38" Margin="4,0,0,0"
                                Command="{Binding HangUpCommand}"/>
                    </Grid>
                </StackPanel>

                <!-- Line 2: choose target -->
                <StackPanel Visibility="{Binding ShowLineTwoSetup, Converter={StaticResource BoolVis}}">
                    <Border Style="{StaticResource Card}" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Badge}" Background="{StaticResource NavyBrush}">
                                <TextBlock Text="L1" Foreground="White" FontSize="11" FontWeight="Bold"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="{Binding ContactName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding CallStateText}" Style="{StaticResource Muted}" FontSize="11"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding CallTimer}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <UniformGrid Columns="2" Margin="-3,8,-3,0">
                        <Button Content="Phone number" Style="{StaticResource SegmentButton}" Margin="3,0"
                                Command="{Binding SetTargetModeCommand}" CommandParameter="phone" Tag="{Binding TargetIsNumber}"/>
                        <Button Content="Agent" Style="{StaticResource SegmentButton}" Margin="3,0"
                                Command="{Binding SetTargetModeCommand}" CommandParameter="agent" Tag="{Binding TargetIsAgent}"/>
                    </UniformGrid>

                    <TextBox Margin="0,8,0,0" Text="{Binding TargetNumber, UpdateSourceTrigger=PropertyChanged}" Tag="Number to call on Line 2"
                             Visibility="{Binding TargetIsNumber, Converter={StaticResource BoolVis}}"/>
                    <ComboBox Margin="0,8,0,0" Height="44" ItemsSource="{Binding Agents}" SelectedItem="{Binding SelectedAgent, Mode=TwoWay}"
                              DisplayMemberPath="Display" Visibility="{Binding TargetIsAgent, Converter={StaticResource BoolVis}}"/>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Call on Line 2" Style="{StaticResource PrimaryButton}" Command="{Binding CallLineTwoCommand}"
                                ToolTip="Puts Line 1 on hold and calls the target privately"/>
                        <Button Grid.Column="1" Content="Blind" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Padding="12,0"
                                Command="{Binding BlindTransferCommand}" ToolTip="Blind transfer — send the call and leave"/>
                        <Button Grid.Column="2" Content="Back" Style="{StaticResource OutlineButton}" Margin="6,0,0,0" Padding="12,0"
                                Command="{Binding CloseLineTwoCommand}"/>
                    </Grid>
                    <TextBlock Text="{Binding LineTwoError}" Foreground="{StaticResource DangerTextBrush}" FontSize="12" TextWrapping="Wrap"
                               Margin="0,6,0,0" Visibility="{Binding HasLineTwoError, Converter={StaticResource BoolVis}}"/>
                </StackPanel>

                <!-- Line 2: active -->
                <StackPanel Visibility="{Binding ShowLineTwoActive, Converter={StaticResource BoolVis}}">
                    <Border CornerRadius="10" Padding="10,8" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LineOneHeld}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource WarnSoftBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource WarnLineBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Badge}" Background="{StaticResource NavyBrush}">
                                <TextBlock Text="L1" Foreground="White" FontSize="11" FontWeight="Bold"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="{Binding ContactName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding LineOneStateText}" Style="{StaticResource Muted}" FontSize="11"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding CallTimer}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border CornerRadius="10" Padding="10,8" Margin="0,6,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LineTwoIsCurrent}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Badge}" Background="{StaticResource CyanBrush}">
                                <TextBlock Text="L2" Foreground="White" FontSize="11" FontWeight="Bold"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="{Binding LineTwoTargetLabel}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding LineTwoStateText}" Foreground="{StaticResource CyanTextBrush}" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding LineTwoTimer}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <UniformGrid Columns="2" Margin="-3,8,-3,0">
                        <Button Content="Transfer &amp; leave" Style="{StaticResource PrimaryButton}" Height="40" Margin="3,0"
                                Command="{Binding CompleteTransferCommand}" ToolTip="Connect Line 1 and Line 2, then you drop off"/>
                        <Button Content="Conference all" Style="{StaticResource SecondaryButton}" Height="40" Margin="3,0"
                                Command="{Binding ConferenceCommand}" ToolTip="Everyone on one call, including you"/>
                    </UniformGrid>
                    <UniformGrid Columns="2" Margin="-3,6,-3,0">
                        <Button Content="{Binding SwitchLineText}" Style="{StaticResource OutlineButton}" Height="36" Margin="3,0"
                                Command="{Binding SwitchLineCommand}"/>
                        <Button Content="End Line 2" Style="{StaticResource DangerOutlineButton}" Height="36" Margin="3,0"
                                Command="{Binding EndLineTwoCommand}"/>
                    </UniformGrid>
                    <TextBlock Text="{Binding LineTwoError}" Foreground="{StaticResource DangerTextBrush}" FontSize="12" TextWrapping="Wrap"
                               Margin="0,6,0,0" Visibility="{Binding HasLineTwoError, Converter={StaticResource BoolVis}}"/>
                </StackPanel>

                <!-- Wrap-up -->
                <Border Visibility="{Binding ShowWrapUp, Converter={StaticResource BoolVis}}" Background="{StaticResource WarnSoftBrush}"
                        BorderBrush="{StaticResource WarnLineBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Call ended · wrap up" Foreground="{StaticResource WarnTextBrush}" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="{Binding CallTimer}" Foreground="{StaticResource WarnTextBrush}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1" Text="{Binding ContactName}" FontSize="14" FontWeight="SemiBold" Margin="0,4,8,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ContactNumber}" Style="{StaticResource Muted}" Margin="0,5,0,0"
                                   TextWrapping="NoWrap"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================================ MESSAGE -->
        <Border Grid.Row="3" Margin="12,8,12,0" CornerRadius="8" Padding="10,6"
                Visibility="{Binding HasMessage, Converter={StaticResource BoolVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource CyanSoftBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding MessageText}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource CyanTextBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Grid.Column="1" Style="{StaticResource LinkButton}" Command="{Binding DismissMessageCommand}" Margin="8,0,0,0"
                        ToolTip="Dismiss">
                    <Path Data="{StaticResource IconClose}" Style="{StaticResource Icon}" Width="10" Height="10"/>
                </Button>
            </Grid>
        </Border>

        <!-- ============================================================ DISPOSITION -->
        <Grid Grid.Row="4" Margin="12,10,12,12" Visibility="{Binding ShowPhoneTab, Converter={StaticResource BoolVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="DISPOSITION" Style="{StaticResource Caps}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding DispositionHint}" Foreground="{Binding DispositionHintColor}" FontSize="11"
                           FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="-3,6,-3,0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Dispositions}" IsEnabled="{Binding DispositionEnabled}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" VerticalAlignment="Top"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource DispositionTile}" GroupName="Disposition" Content="{Binding Label}"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}" ToolTip="{Binding Label}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Callback date/time (CALLBACK / CALLBACK_REQUESTED) -->
            <Grid Grid.Row="2" Margin="0,8,0,0" Visibility="{Binding NeedsCallbackTime, Converter={StaticResource BoolVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,6,0">
                    <TextBlock Text="CALLBACK DATE (ET)" Style="{StaticResource Caps}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding CallbackDates}" SelectedItem="{Binding CallbackDate, Mode=TwoWay}" DisplayMemberPath="Label"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="TIME (ET)" Style="{StaticResource Caps}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding CallbackTimes}" SelectedItem="{Binding CallbackTime, Mode=TwoWay}"/>
                </StackPanel>
            </Grid>

            <TextBox Grid.Row="3" Margin="0,8,0,0" Height="38" Text="{Binding CallbackNumber, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Callback number, 10 digits (if different)" Visibility="{Binding ShowCallbackNumber, Converter={StaticResource BoolVis}}"/>

            <!-- Two lines of text visible; longer comments scroll -->
            <TextBox Grid.Row="4" Margin="0,8,0,0" Height="64" Text="{Binding Comments, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Comments (required)" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                     Padding="6,4" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding DispositionEnabled}"/>

            <CheckBox Grid.Row="5" Margin="0,8,0,0" Content="Set me to Not Ready after saving"
                      IsChecked="{Binding SetNotReadyAfterSave, Mode=TwoWay}" IsEnabled="{Binding DispositionEnabled}"/>

            <Button Grid.Row="6" Content="Save Disposition" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0"
                    Command="{Binding SaveDispositionCommand}"/>
        </Grid>

        <!-- ============================================================ CALLBACKS PAGE -->
        <Grid Grid.Row="2" Grid.RowSpan="3" Visibility="{Binding ShowCallbacks, Converter={StaticResource BoolVis}}">
            <views:CallbacksView DataContext="{Binding Callbacks}"/>
        </Grid>
    </Grid>
</UserControl>

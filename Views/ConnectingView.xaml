<UserControl x:Class="CmxDialer.Views.ConnectingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <StackPanel VerticalAlignment="Center">
            <Border Width="72" Height="72" CornerRadius="36" Background="{StaticResource CyanSoftBrush}" HorizontalAlignment="Center">
                <Path Data="{StaticResource IconPhone}" Width="30" Height="30" Stretch="Uniform"
                      Stroke="{StaticResource CyanTextBrush}" StrokeThickness="2" StrokeLineJoin="Round"/>
            </Border>

            <TextBlock Text="{Binding StepText}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,20,0,0"/>
            <TextBlock Text="{Binding ServerText}" Style="{StaticResource Muted}" HorizontalAlignment="Center"
                       TextAlignment="Center" Margin="0,6,0,0"/>

            <ProgressBar IsIndeterminate="True" Height="4" Margin="40,20,40,0" Foreground="{StaticResource CyanBrush}"
                         Background="{StaticResource LineSoftBrush}" BorderThickness="0"
                         Visibility="{Binding IsWorking, Converter={StaticResource BoolVis}}"/>

            <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolVis}}" Margin="0,20,0,0">
                <Border Background="{StaticResource DangerSoftBrush}" CornerRadius="8" Padding="12,10">
                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerTextBrush}" FontSize="13" TextWrapping="Wrap"/>
                </Border>
                <Button Content="Try again" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0" Command="{Binding RetryCommand}"/>
                <Button Content="Back to campaigns" Style="{StaticResource OutlineButton}" Margin="0,8,0,0" Command="{Binding BackCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
